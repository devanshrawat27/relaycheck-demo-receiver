generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Demo business tables owned solely by the Demo Receiver.
// No RelayCheck platform tables live here.

model DemoOrder {
  id        String   @id
  status    String   @default("PENDING")
  amount    Int
  currency  String   @default("USD")

  @@map("demo_orders")
}

model ProcessedEvent {
  id           Int      @id @default(autoincrement())
  consumerName String
  eventId      String
  processedAt  DateTime @default(now())

  @@unique([consumerName, eventId], name: "consumer_event_idempotency")
  @@map("processed_events")
}

model BusinessEffect {
  id        Int      @id @default(autoincrement())
  orderId   String
  effect    String
  appliedAt DateTime @default(now())

  @@index([orderId])
  @@map("business_effects")
}
