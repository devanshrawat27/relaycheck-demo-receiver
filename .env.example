# RelayCheck Demo Receiver - placeholder values only.
# Copy to .env before overriding anything.
# Never commit a real .env file or real credentials.

# HTTP port for this service.
PORT=3100

# Database. This receiver owns its OWN database (relaycheck_demo) on the local
# PostgreSQL server; it never shares tables with the RelayCheck platform.
DATABASE_URL=postgresql://relaycheck:relaycheck@localhost:5432/relaycheck_demo

# Test-oracle / fault-injection gate. Must be explicitly enabled for those
# endpoints to exist; they fail closed when unset.
RELAYCHECK_TEST_MODE=false
